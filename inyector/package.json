{
  "name": "andysmotors-inyector-metricas",
  "version": "1.0.0",
  "description": "Inyector de metricas de negocio de AndysMotors en CloudWatch (EP4 ADY1103). Sin credenciales en el codigo: usa la cadena por defecto del SDK.",
  "main": "inyector-metricas.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node inyector-metricas.js",
    "normal": "node inyector-metricas.js --modo normal --duracion 3600 --hora-inicio 9",
    "desvio": "node inyector-metricas.js --modo desvio --duracion 420",
    "simular": "node inyector-metricas.js --simular --duracion 5 --intervalo 1"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.700.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
