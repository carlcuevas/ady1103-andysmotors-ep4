{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenegarEC2SinCentroDeCostos",
      "Effect": "Deny",
      "Action": ["ec2:RunInstances", "ec2:CreateVolume"],
      "Resource": ["arn:aws:ec2:*:*:instance/*", "arn:aws:ec2:*:*:volume/*"],
      "Condition": { "Null": { "aws:RequestTag/CentroDeCostos": "true" } }
    },
    {
      "Sid": "DenegarLogGroupSinCentroDeCostos",
      "Effect": "Deny",
      "Action": "logs:CreateLogGroup",
      "Resource": "*",
      "Condition": { "Null": { "aws:RequestTag/CentroDeCostos": "true" } }
    },
    {
      "Sid": "DenegarTopicoSnsSinCentroDeCostos",
      "Effect": "Deny",
      "Action": "sns:CreateTopic",
      "Resource": "*",
      "Condition": { "Null": { "aws:RequestTag/CentroDeCostos": "true" } }
    },
    {
      "Sid": "ProtegerEtiquetaCentroDeCostos",
      "Effect": "Deny",
      "Action": ["ec2:DeleteTags", "logs:UntagResource", "sns:UntagResource", "cloudwatch:UntagResource"],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringEquals": { "aws:TagKeys": ["CentroDeCostos"] },
        "ArnNotLike": { "aws:PrincipalARN": "arn:aws:iam::*:role/FinOpsAdmin" }
      }
    }
  ]
}
